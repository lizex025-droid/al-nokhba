# Applied by Cloudflare Pages to the exported static website.
# These headers do not require JavaScript and keep third-party images/PDFs working.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Permitted-Cross-Domain-Policies: none

# Next.js fingerprints static asset URLs, so they can be cached long-term.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Stable local images are reused by the browser on subsequent page visits.
/materials/*
  Cache-Control: public, max-age=604800

/ai/*
  Cache-Control: public, max-age=604800

/al-nokhba-logo.png
  Cache-Control: public, max-age=604800

/al-nokhba-logo.webp
  Cache-Control: public, max-age=604800

# Allow the browser to check for new service worker versions.
/image-cache-sw.js
  Cache-Control: no-cache
